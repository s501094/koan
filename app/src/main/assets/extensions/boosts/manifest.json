{
  "manifest_version": 2,
  "name": "Koan Boosts",
  "version": "1.0",
  "description": "Applies local per-site styles and hides elements you've zapped. Bundled with the app; makes no network requests.",
  "applications": {
    "gecko": { "id": "boosts@koan.tyell" }
  },
  "permissions": ["<all_urls>", "nativeMessaging"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
